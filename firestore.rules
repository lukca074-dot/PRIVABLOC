rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['code', 'name', 'condition', 'creatorUid', 'creatorName', 'createdAt']) &&
             data.code is string && data.code.size() >= 3 && data.code.size() <= 32 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.condition is string && data.condition.size() >= 5 && data.condition.size() <= 500 &&
             data.creatorUid is string && data.creatorUid.size() >= 1 && data.creatorUid.size() <= 128 &&
             data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 50;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['roomId', 'senderUid', 'senderName', 'text', 'createdAt']) &&
             data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 64 &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 50 &&
             data.text is string && data.text.size() <= 2000;
    }

    // Rooms collection
    match /rooms/{roomId} {
      allow read, get, list: if true;
      allow create: if isValidRoom(request.resource.data);
      allow update: if true;
      allow delete: if true;

      // Messages subcollection
      match /messages/{messageId} {
        allow read, get, list: if true;
        allow create: if isValidMessage(request.resource.data);
        allow delete: if true;
      }
    }
  }
}
